# serializer version: 1
# name: test_generated_config
  '''
  # Generated by meute: rewritten at every launch, do not edit.
  set -g mouse on
  set -g status-left ""
  set -g status-right "#{@meute_status}"
  set -g status-right-length 120
  set -g status-style "bg=default,fg=colour245"
  set -g window-status-format ""
  set -g window-status-current-format ""
  set -g pane-border-lines single
  set -g pane-border-style "fg=colour238"
  set -g pane-active-border-style "fg=colour238"
  set -g focus-events on
  set -g window-style "bg=colour234"
  set -g window-active-style "default"
  set -g visual-activity off
  set -g visual-bell off
  set -g visual-silence off
  set -g bell-action none
  set -g display-time 1000
  bind -n M-n run-shell -b "'/opt/meute/bin/python' '-m' 'meute' 'session' 'next'"
  bind -n M-N run-shell -b "'/opt/meute/bin/python' '-m' 'meute' 'session' 'previous'"
  bind -n M-t if-shell -F "#{e|<:#{client_width},76}" "display-popup -B -E -w 100% -h 12 -T \"\" \"'/opt/meute/bin/python' '-m' 'meute' 'task' 'quick'\"" "display-popup -B -E -w 76 -h 12 -T \"\" \"'/opt/meute/bin/python' '-m' 'meute' 'task' 'quick'\""
  bind -n M-q detach-client
  bind -n M-p switch-client -t =meute:main \; select-pane -t '=meute:main.{right}'
  bind -n M-o if-shell -F "#{window_zoomed_flag}" "" "select-pane -t '=meute:main.{left}'"
  set-hook -g client-attached "run-shell -b \"'/opt/meute/bin/python' '-m' 'meute' 'layout' 'sync'\""
  set-hook -g client-resized "run-shell -b \"'/opt/meute/bin/python' '-m' 'meute' 'layout' 'sync'\""
  
  '''
# ---
