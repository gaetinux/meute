#!/usr/bin/env python3
"""A fake `claude` for tests: replays captured hook payloads through the --settings commands.

Usage: `claude --settings <file> --session-id <id> ...` (or `--resume <id>`, which makes
SessionStart say `source: resume`) or `claude agents --json`.
A first Ctrl-C is ignored, a second within a second ends the session.
MEUTE_FAKE_CLAUDE_SCRIPT picks the sequence (permission, done, exit, end, paste); `paste`
starts like a session, then appends every byte typed or pasted to MEUTE_FAKE_CLAUDE_INPUT.
MEUTE_FAKE_CLAUDE_ARGS, when set, names a file receiving the arguments as a JSON list.
MEUTE_FAKE_CLAUDE_AGENTS names a file printed by `claude agents --json`.
Standard library only.
"""

import json
import os
import shlex
import signal
import subprocess
import sys
import time
import tty
from collections.abc import Callable
from pathlib import Path
from types import FrameType

FIXTURES = Path(__file__).resolve().parents[1] / "fixtures/claude/2.1.302"
_START = ("hook:SessionStart-1", "statusline-1")
SEQUENCES = {
    "permission": (
        *_START,
        "hook:UserPromptSubmit-3",
        "hook:PreToolUse-2",
        "hook:PermissionRequest-1",
    ),
    "done": (
        *_START,
        "hook:UserPromptSubmit-2",
        "hook:PreToolUse-1",
        "hook:PostToolUse-1",
        "hook:Stop-2",
        "statusline-2",
    ),
    "exit": (*_START, "hook:UserPromptSubmit-1", "hook:Stop-1", "hook:SessionEnd-1"),
    "end": ("hook:SessionEnd-1",),
    "paste": _START,
}
BRACKETED_PASTE_ON = b"\x1b[?2004h"
DOUBLE_INTERRUPT_SECONDS = 1.0


def option(args: list[str], name: str) -> str | None:
    """The value following `name` in `args`, if any."""
    return args[args.index(name) + 1] if name in args[:-1] else None


def run_command(command: str, payload: dict[str, object]) -> None:
    """Run a settings command with the payload on stdin, like Claude does."""
    subprocess.run(
        shlex.split(command),
        input=json.dumps(payload),
        text=True,
        env=os.environ,
        capture_output=True,
        check=False,
    )


def replay(settings_path: str, session_id: str, script: str, *, resumed: bool = False) -> None:
    """Replay the sequence `script` through the commands of the settings file."""
    settings = json.loads(Path(settings_path).read_text(encoding="utf-8"))
    for step in SEQUENCES[script]:
        if step.startswith("hook:"):
            name = step.removeprefix("hook:")
            event = name.rsplit("-", 1)[0]
            command = settings["hooks"][event][0]["hooks"][0]["command"]
            path = FIXTURES / "hooks" / f"{name}.json"
        else:
            command = settings["statusLine"]["command"]
            path = FIXTURES / f"{step}.json"
        payload = json.loads(path.read_text(encoding="utf-8"))
        payload["session_id"] = session_id
        if resumed and step.startswith("hook:SessionStart"):
            payload["source"] = "resume"
        run_command(command, payload)


def interrupt_handler(settings: str, session_id: str) -> Callable[[int, FrameType | None], None]:
    """Ignore a first Ctrl-C; a second within a second ends the session and exits 0."""
    last: list[float] = []

    def handle(_signum: int, _frame: FrameType | None) -> None:
        now = time.monotonic()
        if last and now - last[0] <= DOUBLE_INTERRUPT_SECONDS:
            replay(settings, session_id, "end")
            sys.exit(0)
        last[:] = [now]

    return handle


def raw_terminal() -> None:
    """Ask for bracketed pastes; no line editing, no CR-to-LF: the bytes as tmux sends them."""
    tty.setraw(sys.stdin.fileno())
    os.write(sys.stdout.fileno(), BRACKETED_PASTE_ON)


def record_input(path: str) -> None:
    """Append every byte read from the terminal to `path` until it closes."""
    with Path(path).open("ab", buffering=0) as recorded:
        while chunk := os.read(sys.stdin.fileno(), 4096):
            recorded.write(chunk)


def main(args: list[str]) -> int:
    """Entry point."""
    if args[:1] == ["agents"]:
        agents = os.environ.get("MEUTE_FAKE_CLAUDE_AGENTS")
        sys.stdout.write(Path(agents).read_text(encoding="utf-8") if agents else "[]\n")
        return 0
    if recorded := os.environ.get("MEUTE_FAKE_CLAUDE_ARGS"):
        Path(recorded).write_text(json.dumps(args), encoding="utf-8")
    settings = option(args, "--settings")
    resumed = "--resume" in args
    session_id = option(args, "--resume" if resumed else "--session-id")
    if settings is None or session_id is None:
        sys.stderr.write("fake claude: --settings and --session-id (or --resume) are required\n")
        return 2
    script = os.environ.get("MEUTE_FAKE_CLAUDE_SCRIPT", "permission")
    signal.signal(signal.SIGINT, interrupt_handler(settings, session_id))
    if script == "paste":
        raw_terminal()  # ready before SessionStart tells meute it may paste
    replay(settings, session_id, script, resumed=resumed)
    if script == "exit":
        return 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    if script == "paste":
        record_input(os.environ["MEUTE_FAKE_CLAUDE_INPUT"])
        return 0
    while True:
        signal.pause()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
